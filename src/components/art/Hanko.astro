---
// Red seal stamp, a quiet signature.
interface Props { class?: string; text?: string }
const { class: cls = '', text = '雲' } = Astro.props;
---
<svg class={cls} viewBox="0 0 80 80" aria-hidden="true" focusable="false">
  <rect x="4" y="4" width="72" height="72" rx="9" fill="none" stroke="var(--color-shu)" stroke-width="4" />
  <rect x="11" y="11" width="58" height="58" rx="5" fill="var(--color-shu)" />
  <text x="40" y="54" text-anchor="middle" font-family="Noto Sans JP, sans-serif" font-size="38" fill="var(--color-washi)">{text}</text>
</svg>
