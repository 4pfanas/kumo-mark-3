---
// Paper chōchin with 雲, swings gently from its cord.
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<svg class={cls} viewBox="0 0 90 220" aria-hidden="true" focusable="false">
  <g class="sway">
    <line x1="45" y1="0" x2="45" y2="44" stroke="var(--color-sumi)" stroke-width="1.6" />
    <rect x="30" y="42" width="30" height="10" rx="2" fill="var(--color-sumi)" />
    <path d="M30 52C4 70 4 150 30 168h30c26-18 26-98 0-116Z" fill="var(--color-shu)" />
    <g stroke="var(--color-shu-deep)" stroke-width="1.3" fill="none" opacity="0.55">
      <path d="M14 72h62M9 90h72M7 110h76M9 130h72M14 150h62" />
    </g>
    <text x="45" y="122" text-anchor="middle" font-family="Noto Sans JP, sans-serif" font-weight="400" font-size="30" fill="#fbf7f0">雲</text>
    <rect x="30" y="168" width="30" height="10" rx="2" fill="var(--color-sumi)" />
    <path d="M38 178v26M45 178v32M52 178v26" stroke="var(--color-shu)" stroke-width="2.4" stroke-linecap="round" />
  </g>
</svg>
